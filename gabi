    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --primary: #10b981; 
            --secondary: #059669; 
            --accent: #34d399; 
            --bg: #020617;
        }

        body {
            background-color: var(--bg);
            color: #f3f4f6;
            font-family: 'Inter', sans-serif;
            scroll-behavior: smooth;
        }

        .font-serif { font-family: 'Playfair Display', serif; }

        /* Efecto de cristal para tarjetas y navegación */
        .glass {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
        }

        .gradient-text {
            background: linear-gradient(135deg, #34d399 0%, #10b981 50%, #059669 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Capa de gradiente decorativa en el fondo */
        .hero-gradient {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 100vh;
            background: radial-gradient(circle at 50% 50%, rgba(16, 185, 129, 0.1) 0%, transparent 50%),
                        radial-gradient(circle at 80% 20%, rgba(5, 150, 105, 0.08) 0%, transparent 40%);
            z-index: -1;
        }

        /* Contenedor del Avatar Circular */
        .avatar-container {
            width: 180px;
            height: 180px;
            margin-bottom: 2.5rem;
            position: relative;
        }

        .avatar-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
            border: 4px solid var(--primary);
            box-shadow: 0 0 40px rgba(16, 185, 129, 0.4);
        }

        /* Animación de flotado */
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
            100% { transform: translateY(0px); }
        }

        .floating { animation: float 6s ease-in-out infinite; }

        /* Estilo de enlaces de navegación */
        .nav-link {
            position: relative;
            transition: color 0.3s ease;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -4px;
            left: 0;
            background: var(--primary);
            transition: width 0.3s ease;
        }

        .nav-link:hover::after {
            width: 100%;
        }

        /* Hover para tarjetas de entregas */
        .submission-card {
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .submission-card:hover {
            transform: translateY(-10px);
            border-color: var(--primary);
            background: rgba(255, 255, 255, 0.07);
        }
    </style>
</head>
